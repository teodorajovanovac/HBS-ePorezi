# =============================================================
# HBS ZARADE - Konfiguracija baza podataka
# =============================================================
#
# Kopirajte ovaj fajl u app.local.properties i prilagodite putanje.
# Fajl app.local.properties NIJE u git-u (ignorisan je).
#
# Putanje mogu biti:
#  1. Relativne (u odnosu na koren projekta ili ovaj konfiguracioni fajl):
#     - db\data_zarade.mdb
#     - ..\..\db\data_zarade.mdb
#     - stari_access\db\data_zarade.mdb
#     - stari_access/db/data_zarade.mdb
#
#  2. Apsolutne (kopirane direktno iz Windows Explorer-a):
#     - C:\db\data_zarade.mdb
#     - D:\Baze\data_zarade.mdb
#
# Separator može biti Windows backslash (\) ili slash (/).
# Aplikacija automatski prepoznaje da li je u pitanju relativna ili apsolutna putanja.
# =============================================================

# Glavna poslovna baza (primaoci, isplatioci, sifarnici)
db.main.path=stari_access\db\data_zarade.mdb
